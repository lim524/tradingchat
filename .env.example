# Vercel server-only secrets. Never commit real values.
APP_ORIGIN=https://your-app.vercel.app
# Set the private site password requested by the owner (minimum 10 characters).
APP_PASSWORD=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
APP_SESSION_SECRET=
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=
GEMINI_MONITOR_MODEL=
AI_DAILY_CALL_LIMIT=100
# No Supabase Auth login, anon key or OWNER_EMAIL needed.
# Binance keys remain in the PC OS keyring, never Vercel.
