# Vercel server-only variables. Never use NEXT_PUBLIC_ / VITE_ for these.
APP_ORIGIN=https://your-app.vercel.app
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Personal deployment: only this confirmed Supabase user's email can sign in.
OWNER_EMAIL=
OPENAI_API_KEY=
# Set an exact model ID available to your API account; no silent fallback.
OPENAI_CHAT_MODEL=
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=
GEMINI_MONITOR_MODEL=
AI_DAILY_CALL_LIMIT=100
# Binance keys are NEVER set on Vercel. See runner/README.md.
